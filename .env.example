# Appwrite sync configuration (optional).
# Copy to `.env` and fill in. Without these, the app runs fully locally.

# Client SDK config (safe to ship in the desktop app — no secret key).
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=your_project_id
VITE_APPWRITE_DB=clipboard
VITE_APPWRITE_COLLECTION=clips

# Server API key — used ONLY by scripts/setup-appwrite.mjs to create the
# database/collection. Never bundled into the app. Do not commit your real key.
APPWRITE_API_KEY=your_server_api_key
